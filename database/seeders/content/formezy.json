                {
                    "tag": "AskEzy intelligence",
                    "title": "Get Answers. Stay in Control.",
                    "img": "assets/images/products/formezy/hl-askezy.webp",
                    "btn": "",
                    "href": "",
                    "text": "AskEzy is built into Formezy so teams can query live data, surface what needs attention, and act faster, without switching tools or digging through disconnected reports.",
                    "points": [
                        "Get accurate answers from business data",
                        "Summarize reports, documents, and updates instantly",
                        "Receive reminders for tasks, meetings, and operations",
                        "Track real-time updates across workflows",
                        "Understand what's happening without manual follow-ups"
                    ]
                },
                {
                    "tag": "Low-code / no-code",
                    "title": "Build Business Applications Visually",
                    "img": "assets/images/products/formezy/hl-low-code.webp",
                    "btn": "",
                    "href": "",
                    "text": "Empower teams to assemble workflows and apps with drag-and-drop components instead of heavy engineering, so ideas move from whiteboard to production without losing governance.",
                    "points": [
                        "Compose screens, validations, and data models visually",
                        "Ship internal tools quickly with reusable modules",
                        "Keep IT guardrails while business teams iterate safely"
                    ]
                },
                {
                    "tag": "Workflow automation",
                    "title": "Work That Never Stalls in Inboxes",
                    "img": "assets/images/products/formezy/hl-workflow-automation.webp",
                    "btn": "",
                    "href": "",
                    "text": "Replace manual follow-ups with structured automation: approvals, handoffs, and notifications run in sequence so work keeps moving.",
                    "points": [
                        "Trigger steps from events, schedules, or data changes",
                        "Built-in escalations, reminders, and human-in-the-loop paths",
                        "Monitor SLAs and bottlenecks from one operations view"
                    ]
                },
                {
                    "tag": "Mobile access",
