        {
            "key": "pd_features",
            "scope": "formezy",
            "items": [
                {
                    "img": "",
                    "tag": "",
                    "title": "Role-Based Access",
                    "text": "Keep sensitive operations visible only to the right people, with permissions scoped by role, team, and data sensitivity."
                },
                {
                    "img": "",
                    "tag": "",
                    "title": "Multi-Level Approvals",
                    "text": "Sequential and parallel approval chains with delegation, escalations and reminders tied to the SLAs you define."
                },
                {
                    "img": "",
                    "tag": "",
                    "title": "Audit Logs",
                    "text": "An immutable history of who changed what and when, with views and exports aligned to compliance reviews."
                },
                {
                    "img": "",
                    "tag": "",
                    "title": "Data Centralization",
                    "text": "One governed layer for operational data, with shared definitions for customers, orders, and assets."
                },
                {
                    "img": "",
                    "tag": "",
                    "title": "Reporting & Dashboards",
                    "text": "Reporting that draws from the same live records everyone uses, from the shopfloor to leadership."
