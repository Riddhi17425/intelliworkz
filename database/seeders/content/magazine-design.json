        {
            "key": "mg_faqs",
            "scope": "magazine-design",
            "items": [
                [
                    "What are magazine design services?",
                    "Magazine design services cover the end-to-end design of a publication: cover design, layout design, typography, image treatment, and file preparation for print or digital output. The scope depends on whether you need a single issue or an ongoing production arrangement."
                ],
                [
                    "What is the difference between print and digital magazine design?",
                    "Print files are prepared to your printer's specifications. Digital editions are exported and tested across devices. Both can be produced for the same issue."
                ],
                [
                    "Do you offer custom magazine design or work from templates?",
                    "Both. We design custom magazines around your brief, and we develop templates and style guides so your format stays consistent."
                ],
                [
                    "How long does it take to design a magazine?",
                    "The timeline is agreed at the start, once the issue scope, page count, format and delivery date are confirmed."
                ],
                [
                    "Can you design both the cover and internal layouts?",
                    "Yes. The scope covers the cover concept, the internal layouts, and the placement of final copy and images."
                ],
                [
                    "What file formats do you deliver?",
                    "Print-ready PDFs, digital editions, and the source files, organised for future use."
                ],
                [
                    "Do you handle ongoing issues or only one-off projects?",
                    "Both. The same designer or team can work on your publication every issue, so your standards carry forward without re-briefing."
                ]
            ]
        }
