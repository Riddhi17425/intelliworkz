            "scope": "pre-press-service",
            "items": [
                {
                    "no": "01",
                    "bg": "#EFF7FA",
                    "c": "#53A2BC",
                    "iy": 234,
                    "title": "Artwork Review",
                    "text": "First, we examine your design files. We then use the dimensions, specifications, and production guidelines for the print run and the colors you require to check for any problems before the file gets into production.",
