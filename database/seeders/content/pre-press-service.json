                },
                {
                    "no": "04",
                    "bg": "#EFF7FA",
                    "c": "#59B38D",
                    "iy": 234,
                    "title": "Print Optimization",
                    "text": "The artwork file is adapted for the print method of choice (offset, flexo, gravure, or digital) so as to enable an accurate color result and efficient production.",
                    "img": "assets/images/prepress/step-4.png"
