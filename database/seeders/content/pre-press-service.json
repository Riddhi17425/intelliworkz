        {
            "key": "pp_services",
            "scope": "pre-press-service",
            "items": [
                {
                    "title": "Artwork Verification &amp; File Preparation",
                    "open": true,
                    "points": [],
                    "para": "Prior to beginning production, all artwork is checked for the sizes, resolution, fonts, profiles, bleed setup, and print specifications."
                },
                {
                    "title": "Colour Management",
                    "points": [],
                    "para": "Getting the color right to keep branding consistent. We also colour profile artwork, balance your files, and have them colour-balanced, ready for the chosen printing method."
                },
                {
                    "title": "Print Proofing",
                    "points": [],
                    "para": "Proofing in print is important so we can ensure nothing will go wrong during a bulk run! We supply both digital and production proofs to ensure layouts, color, text placement, and overall print will look as expected."
                },
                {
                    "title": "Packaging Pre-Press",
                    "points": [],
                    "para": "The level of technical finesse in packaging is one of higher expertise, and we specialize in preparing artwork for cartons, labels, flexible packages, sleeves, and our client’s product packaging, paying keen attention to the dielines, trapping, overprints, and finishing for the final production stages."
                },
                {
                    "title": "Commercial Print Preparation",
                    "points": [],
                    "para": "Let’s move that content online… or the other way around! Whether you need anything from catalogues and brochures to leaflets, posters, yearly reports, or just about any general marketing material, our reports-ready art is created to commercial standards and minimizes errors, which save you money on your print production."
                },
                {
                    "title": "Digital Pre-Press Services",
                    "points": [],
                    "para": "Short runs, printing on demand, variable data printing – our digital pre-press services cover your digital printing workflow completely, and your files are prepared and adjusted specifically for the print and their associated RIPs."
                }
            ]
        },
        {
