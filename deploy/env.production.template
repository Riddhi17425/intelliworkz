# Live settings for the Intelliworkz CMS on a cPanel host.
# 1. Fill in the values marked  >>> CHANGE <<<
# 2. Upload this file next to the application folder's "artisan" file and rename it to  .env   (a name starting with a dot)
# Never put this file inside public_html / the public folder.

APP_NAME=Intelliworkz
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
# >>> CHANGE <<<  the address of the live website, with https:// and without a trailing slash
APP_URL=https://www.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# >>> CHANGE <<<  the MySQL database you create in cPanel (names usually look like cpaneluser_dbname)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_intelliworkz
DB_USERNAME=cpaneluser_intelliworkz
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# the live site runs on https, so the login cookie is only sent over https
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
FILESYSTEM_DISK=local
# shared hosting has no queue worker: do everything immediately
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# >>> CHANGE <<<  e-mail. Used to send the contact-form inquiries to your inbox
# (also set the address in the admin panel: Company settings -> Inquiry notification e-mail).
# In cPanel create an e-mail account (e.g. no-reply@your-domain.com) and use its details below.
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@your-domain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
